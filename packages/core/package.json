{
  "name": "@recon-os/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared domain types, interfaces, and primitives for Recon-OS.",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build && node --test tests/dataset.test.ts tests/validation.test.ts tests/loader.test.ts"
  }
}